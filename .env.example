# Copy to .env.local for local `npm run dev`, or paste these into your
# host's Environment Variables settings (e.g. Vercel Project Settings ->
# Environment Variables) for the deployed app. Never commit real keys.

# Required for every agent to actually run.
ANTHROPIC_API_KEY=

# Optional. News Agent and Bear Agent use this model when set; without it
# they automatically fall back to Claude so the desk still runs.
OPENAI_API_KEY=

# Optional but strongly recommended once deployed: without these, state
# (portfolio, trade journal, logs) resets on every cold start instead of
# persisting between cycles. Free tier at https://console.upstash.com
# (sign in with GitHub) -> Create Database -> Redis -> REST API section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
